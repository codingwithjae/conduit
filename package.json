{
  "name": "conduit",
  "version": "0.1.0",
  "private": true,
  "description": "A terminal-first, policy-aware model delegation CLI and MCP server.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "conduit": "./bin/conduit.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin/",
    "dist/"
  ],
  "scripts": {
    "pretest": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "commander": "^14.0.0",
    "ink": "^5.2.1",
    "react": "^18.3.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.0.7"
  }
}
